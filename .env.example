# ==============================================================================
# MailShieldAI Environment Configuration (.env)
# Works identically across Windows (PowerShell / CMD) and macOS / Linux
# ==============================================================================

# ── Application Settings ─────────────────────────────────────────────────────
APP_NAME=MailShieldAI
APP_ENV=development
DEBUG=true

# ── Server Ports & URLs ──────────────────────────────────────────────────────
# Backend runs on Port 8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ML Inference Engine runs on Port 8001
# Use http://localhost:8001 when running locally on Windows or Mac
# Use http://ml-service:8001 only when running inside Docker Compose
ML_SERVICE_URL=http://localhost:8001

# Frontend Dashboard runs on Port 5173
FRONTEND_URL=http://localhost:5173

# ── Database (Optional for in-memory demo mode) ───────────────────────────────
# Local SQLite or Docker PostgreSQL:
POSTGRES_USER=mailshield
POSTGRES_PASSWORD=mailshield_dev_2024
POSTGRES_DB=mailshieldai
DATABASE_URL=postgresql+asyncpg://mailshield:mailshield_dev_2024@localhost:5432/mailshieldai
DATABASE_URL_SYNC=postgresql://mailshield:mailshield_dev_2024@localhost:5432/mailshieldai

# ── Redis (Optional event bus) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (Optional campaign graph) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mailshield_neo4j_2024

# ── MinIO Object Storage (Optional for S3-compatible WORM evidence storage) ───
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mailshield
MINIO_SECRET_KEY=mailshield_minio_2024
MINIO_BUCKET=evidence-vault
MINIO_USE_SSL=false

# ── MaxMind GeoLite2 License Key (Sign up free at maxmind.com) ────────────────
# If empty, automatically falls back to free IP geolocation API
GEOLITE2_LICENSE_KEY=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

# ── CORS Settings ─────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
